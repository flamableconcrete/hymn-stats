rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function member() { return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid)) && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['admin', 'contributor']; }
    function admin() { return member() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin'; }
    function owns(owner) { return member() && (request.auth.uid == owner || admin()); }
    function observation(id) { return get(/databases/$(database)/documents/observations/$(id)).data; }
    function nextObservation(id) { return getAfter(/databases/$(database)/documents/observations/$(id)).data; }
    function validObservation(data) {
      return data.keys().hasOnly(['id', 'eventId', 'ownerId', 'date', 'congregation', 'meetingType', 'status', 'items', 'stood', 'sacramentReady', 'sundayType', 'holiday', 'notes', 'archived', 'version', 'updatedAt', 'lastMutationId'])
        && data.ownerId is string && data.eventId is string && data.date is string && data.congregation is string && data.meetingType is string
        && data.items is list && data.status in ['draft', 'published'] && data.version is int && data.archived is bool
        && (data.status == 'draft' || (data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.congregation.size() > 0 && data.meetingType.size() > 0 && data.items.size() > 0));
    }
    function audited(id) {
      return existsAfter(/databases/$(database)/documents/history/$(id)/entries/$(request.resource.data.lastMutationId))
        && getAfter(/databases/$(database)/documents/history/$(id)/entries/$(request.resource.data.lastMutationId)).data.after == request.resource.data;
    }
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if admin() || (signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['email', 'role'])
        && request.resource.data.email == request.auth.token.email.lower()
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower()))
        && request.resource.data.role == get(/databases/$(database)/documents/invitations/$(request.auth.token.email.lower())).data.role
        && request.resource.data.role in ['contributor', 'admin']);
      allow update: if admin() && request.resource.data.keys().hasOnly(['email', 'role']) && request.resource.data.role in ['admin', 'contributor', 'revoked'];
      allow delete: if false;
    }
    match /invitations/{email} {
      allow get: if signedIn() && (request.auth.token.email.lower() == email || admin());
      allow list: if admin();
      allow write: if admin() && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role in ['admin', 'contributor', 'revoked'];
    }
    match /observations/{id} {
      allow get: if member() && !exists(/databases/$(database)/documents/observations/$(id));
      allow read: if member() && (resource.data.ownerId == request.auth.uid || admin() || resource.data.status == 'published');
      allow create: if member() && request.resource.data.id == id && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.version == 1 && validObservation(request.resource.data) && audited(id);
      allow update: if owns(resource.data.ownerId) && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == id && request.resource.data.version == resource.data.version + 1
        && validObservation(request.resource.data) && audited(id);
      allow delete: if false;
    }
    match /privateObservations/{id} {
      allow get: if member() && !exists(/databases/$(database)/documents/privateObservations/$(id));
      allow read: if owns(observation(id).ownerId);
      allow create, update: if owns(nextObservation(id).ownerId)
        && request.resource.data.keys().hasOnly(['ownerId', 'version', 'chorister', 'organist', 'notes', 'legacy'])
        && request.resource.data.ownerId == nextObservation(id).ownerId && request.resource.data.version == nextObservation(id).version
        && getAfter(/databases/$(database)/documents/history/$(id)/entries/$(nextObservation(id).lastMutationId)).data.privateAfter == request.resource.data;
      allow delete: if false;
    }
    match /history/{id}/entries/{entryId} {
      allow read: if owns(observation(id).ownerId);
      allow create: if owns(nextObservation(id).ownerId)
        && request.resource.data.keys().hasOnly(['actorUid', 'before', 'after', 'privateBefore', 'privateAfter', 'committedAt'])
        && request.resource.data.actorUid == request.auth.uid && request.resource.data.committedAt == request.time
        && request.resource.data.after == nextObservation(id) && request.resource.data.after.lastMutationId == entryId
        && ((!exists(/databases/$(database)/documents/observations/$(id)) && request.resource.data.before == null && request.resource.data.after.version == 1)
          || (exists(/databases/$(database)/documents/observations/$(id)) && request.resource.data.before == observation(id) && request.resource.data.after.version == observation(id).version + 1))
        && request.resource.data.privateAfter == getAfter(/databases/$(database)/documents/privateObservations/$(id)).data
        && ((!exists(/databases/$(database)/documents/privateObservations/$(id)) && request.resource.data.privateBefore == null)
          || request.resource.data.privateBefore == get(/databases/$(database)/documents/privateObservations/$(id)).data);
      allow update, delete: if false;
    }
    function validEvent(data, id) {
      return data.keys().hasOnly(['date', 'congregation', 'meetingType', 'creatorUid', 'selectedObservationId', 'status', 'archived'])
        && data.status in ['draft', 'published'] && data.creatorUid is string && data.archived is bool
        && ((data.selectedObservationId == '' && data.status == 'draft') ||
          (data.selectedObservationId != '' && nextObservation(data.selectedObservationId).eventId == id
            && nextObservation(data.selectedObservationId).status == 'published'
            && data.date == nextObservation(data.selectedObservationId).date
            && data.congregation == nextObservation(data.selectedObservationId).congregation
            && data.meetingType == nextObservation(data.selectedObservationId).meetingType));
    }
    match /events/{id} {
      allow get: if member() && !exists(/databases/$(database)/documents/events/$(id));
      allow read: if member() && (resource.data.status == 'published' || resource.data.creatorUid == request.auth.uid || admin());
      allow create: if member() && request.resource.data.creatorUid == request.auth.uid && validEvent(request.resource.data, id)
        && (request.resource.data.selectedObservationId == '' || nextObservation(request.resource.data.selectedObservationId).ownerId == request.auth.uid);
      allow update: if member() && validEvent(request.resource.data, id) && request.resource.data.creatorUid == resource.data.creatorUid
        && (admin() || (resource.data.creatorUid == request.auth.uid
          && (resource.data.selectedObservationId == '' || observation(resource.data.selectedObservationId).ownerId == request.auth.uid)
          && (request.resource.data.selectedObservationId == '' || nextObservation(request.resource.data.selectedObservationId).ownerId == request.auth.uid)));
      allow delete: if false;
    }
    match /imports/{id} { allow read, write: if admin(); }
    match /importIssues/{id} { allow read, write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
